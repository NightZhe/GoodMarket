# Supabase 專案的網址與 anon key（Project Settings → API）
# anon key 可公開，資料安全靠 Row Level Security，見 supabase/schema.sql
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Cloudflare Turnstile 的 sitekey（公開值，登入傳送驗證碼前的安全驗證）。
# 本機與預演用 Cloudflare 官方測試值 1x00000000000000000000AA（一律通過）；正式值在推 main 前設定。
# 沒設定時前端不載入安全驗證，照常可傳送（伺服器端沒開 captcha 時才會成功）。
VITE_TURNSTILE_SITEKEY=1x00000000000000000000AA
